<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="100dp"
    android:layout_weight="1"
    android:background="@drawable/weather_day_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/weatherDayContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.78"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">
        <TextView
            android:id="@+id/weatherDayName"
            style="@style/WeatherText"
            android:importantForAccessibility="no"
            android:textSize="14dp" />
        <TextView
            android:id="@+id/weatherDayDate"
            style="@style/WeatherText"
            android:layout_marginTop="1dp"
            android:alpha="0.72"
            android:importantForAccessibility="no"
            android:textSize="10.5dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/weatherDayIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/weatherDayHigh"
                style="@style/WeatherText"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:textSize="19dp" />
            <TextView
                android:id="@+id/weatherDayLow"
                style="@style/WeatherText"
                android:layout_marginStart="6dp"
                android:alpha="0.75"
                android:importantForAccessibility="no"
                android:textSize="15.5dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/weatherDayRain"
            style="@style/WeatherText"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:textSize="11.5dp" />
    </LinearLayout>
</FrameLayout>
