<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="90dp"
    android:layout_weight="1"
    android:background="@drawable/weather_day_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/weatherDayContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.78"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/weatherDayName"
            style="@style/WeatherText"
            android:importantForAccessibility="no"
            android:textSize="14.5dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/weatherDayIcon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/weatherDayHigh"
                style="@style/WeatherText"
                android:layout_marginStart="13dp"
                android:importantForAccessibility="no"
                android:textSize="19.5dp" />
            <TextView
                android:id="@+id/weatherDayLow"
                style="@style/WeatherText"
                android:layout_marginStart="12dp"
                android:alpha="0.75"
                android:importantForAccessibility="no"
                android:textSize="15.5dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/weatherDayRain"
            style="@style/WeatherText"
            android:importantForAccessibility="no"
            android:textSize="12dp" />
    </LinearLayout>
</FrameLayout>
