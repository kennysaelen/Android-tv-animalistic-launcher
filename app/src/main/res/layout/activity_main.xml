<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/bgBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/bgFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="184dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <View
        android:id="@+id/dashboardBottomScrim"
        android:layout_width="match_parent"
        android:layout_height="151dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <View
        android:id="@+id/forecastScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/weather_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="44dp"
        android:layout_marginTop="26dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:shadowColor="#73000000"
            android:shadowDy="1"
            android:shadowRadius="9"
            android:textColor="#FFFFFF"
            android:textSize="60dp" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:alpha="0.9"
            android:fontFamily="sans-serif-light"
            android:shadowColor="#73000000"
            android:shadowDy="1"
            android:shadowRadius="9"
            android:textColor="#FFFFFF"
            android:textSize="17dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="38dp"
        android:layout_marginTop="30dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/weatherShortcut"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/weather_control_background"
            android:clickable="true"
            android:contentDescription="@string/weather_open"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@id/weatherShortcut"
            android:nextFocusRight="@id/gear"
            android:nextFocusUp="@id/weatherShortcut"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:id="@+id/weatherIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_partly" />
            <TextView
                android:id="@+id/weatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-light"
                android:importantForAccessibility="no"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="@string/weather_unavailable_temperature"
                android:textColor="#FFFFFF"
                android:textSize="16dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/netIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="15dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_wifi" />

        <ImageView
            android:id="@+id/gear"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="9dp"
            android:alpha="0.55"
            android:contentDescription="@string/settings"
            android:focusable="true"
            android:nextFocusLeft="@id/weatherShortcut"
            android:nextFocusRight="@id/gear"
            android:nextFocusUp="@id/gear"
            android:padding="6dp"
            android:src="@drawable/ic_gear" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="55dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:alpha="0.85"
        android:fontFamily="sans-serif-light"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="5"
        android:textColor="#FFFFFF"
        android:textSize="14dp" />

    <include layout="@layout/forecast" />

    <include layout="@layout/apps" />
</FrameLayout>
